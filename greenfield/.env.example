# Copie para .env (cp .env.example .env). O .env fica fora do git.

# Chave da API da Anthropic usada pelo agente de triagem.
# O facilitador entrega uma chave temporária no dia; ela é revogada no fim do workshop.
ANTHROPIC_API_KEY=

# Modelo usado na classificação e na resposta.
ANTHROPIC_MODEL=claude-haiku-5-5

# Banco local: docker compose up -d db (docker-compose.yml).
DATABASE_URL=postgres://greenfield:greenfield@localhost:5432/greenfield

# Porta da API. Troque se a 3000 estiver ocupada.
PORT=3000

# Banco de teste: criado por docker/initdb/ na primeira subida do volume.
DATABASE_URL_TEST=postgres://greenfield:greenfield@localhost:5432/greenfield_test
